exports[`I-103b markup snapshots (real SPX GEX and market-tide payloads) > TideSentimentBanner 1`] = `"<div data-testid="tide-sentiment-banner" style="display:flex;flex-wrap:wrap;align-items:center;gap:14px;padding:8px 12px;border-radius:4px;border:1px solid var(--negative, #ef4444);background:rgba(148,163,184,0.04);font-family:var(--font-mono);font-size:12px"><span style="color:var(--text-muted);letter-spacing:0.08em;font-size:11px">TIDE SENTIMENT</span><span title="Slope of the net call−put premium spread. Flow descriptor, not a price predictor." style="color:var(--negative, #ef4444);font-weight:700;letter-spacing:0.04em;cursor:help">▼ BEARISH · STRONG</span><span style="color:var(--text-secondary)">call selling</span><span style="color:var(--text-muted)">accelerating</span><span style="color:var(--positive, #22c55e)">vol confirms</span><span style="margin-left:auto;color:var(--text-muted)">divergence 100% · spread -324M · slope -359M/hr</span></div>"`;
