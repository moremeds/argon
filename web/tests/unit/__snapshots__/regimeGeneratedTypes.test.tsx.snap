exports[`I-103b markup snapshots (real SPX GEX and market-tide payloads) > MarketTideChart 1`] = `"<div class="section" data-testid="market-tide-chart"><div class="section-header"><div class="section-title">Market Tide — Net Options Premium, last 5 sessions</div><div style="display:flex;gap:14px;flex-wrap:wrap;align-items:center"><span style="display:inline-flex;align-items:center;gap:6px;font-family:var(--font-mono);font-size:10px;letter-spacing:0.06em;color:var(--text-secondary)"><svg width="20" height="6" aria-hidden="true"><line x1="0" x2="20" y1="3" y2="3" stroke="var(--positive, #22c55e)" stroke-width="2"></line></svg>CALL PREM</span><span style="display:inline-flex;align-items:center;gap:6px;font-family:var(--font-mono);font-size:10px;letter-spacing:0.06em;color:var(--text-secondary)"><svg width="20" height="6" aria-hidden="true"><line x1="0" x2="20" y1="3" y2="3" stroke="var(--negative, #ef4444)" stroke-width="2"></line></svg>PUT PREM</span><span style="display:inline-flex;align-items:center;gap:6px;font-family:var(--font-mono);font-size:10px;letter-spacing:0.06em;color:var(--text-secondary)"><svg width="20" height="6" aria-hidden="true"><line x1="0" x2="20" y1="3" y2="3" stroke="var(--accent-warm, #F5A623)" stroke-width="2"></line></svg>SPY</span><span style="display:inline-flex;align-items:center;gap:6px;font-family:var(--font-mono);font-size:10px;letter-spacing:0.06em;color:var(--text-secondary)"><svg width="20" height="6" aria-hidden="true"><line x1="0" x2="20" y1="3" y2="3" stroke="var(--accent-vol, #38bdf8)" stroke-width="2"></line></svg>NET VOL</span></div></div><div class="section-body" style="padding:8px 12px 12px"><svg role="img" aria-label="Market-wide net options premium, last 5 sessions" viewBox="0 0 880 320" style="width:100%;height:320px;display:block"><title>Market tide — net call/put premium, spot overlay, net volume</title><rect x="245.6196319018405" y="16" width="177.87116564417178" height="266" fill="rgba(148,163,184,0.05)"></rect><rect x