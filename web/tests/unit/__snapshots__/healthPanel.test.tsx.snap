exports[`HealthPanel > keeps dashes for missing metrics 1`] = `"<div><div style="border-top: 1px solid var(--border-dim);"><button type="button" aria-expanded="true" aria-controls="health-panel-body" title="Status: WARN. Click to collapse." style="width: 100%; display: flex; align-items: center; justify-content: space-between; gap: 8px; padding: 10px 16px; background: transparent; color: var(--text-secondary); cursor: pointer; font-family: var(--font-mono); font-size: 11px; letter-spacing: 1.5px; text-transform: uppercase;"><span style="display: flex; align-items: center; gap: 6px;"><span style="width: 8px; height: 8px; background: var(--warning); display: inline-block;"></span><span style="color: var(--text-muted);">Status</span><span style="color: var(--text-secondary); white-space: nowrap;">WARN</span><span style="color: var(--text-muted); text-transform: none; letter-spacing: 0;" title="Deployed backend version v0.0.0-test">v0.0.0-test</span></span><span aria-hidden="true">▾</span></button><div id="health-panel-body" style="padding: 0px 16px 12px 16px;"><div style="display: flex; justify-content: space-between; gap: 8px; font-family: var(--font-mono); font-size: 11px; padding: 3px 0px 8px 0px; color: var(--text-muted); align-items: center;"><span style="color: var(--text-secondary);">Health</span><button type="button" style="background: transparent; border: 1px solid var(--border-dim); color: var(--text-secondary); cursor: pointer; font-family: var(--font-mono); font-size: 11px; height: 24px; padding: 0px 8px; text-transform: uppercase;">Benchmark</button></div><div style="display: flex; justify-content: space-between; gap: 8px; font-family: var(--font-mono); font-size: 11px; padding: 3px 0px; color: var(--text-muted);"><span style="white-space: nowrap;">API</span><span style="display: flex; align-items: center; gap: 6px;"><span style="width: 8px; height: 8px; background: var(--positive); display: inline-block;"></span><span style="color: var(--text-secondary); 