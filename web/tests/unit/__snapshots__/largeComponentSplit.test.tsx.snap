// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`GrgSubTabView markup snapshot > null 1`] = `"<div class="regime-empty" data-testid="grg-empty">No GRG snapshot yet. The scanner runs every 15 min (market hours + post-close settlement).</div>"`;

exports[`GrgSubTabView markup snapshot > prod fixture (2026-10-02) 1`] = `"<div class="section gex-panel" data-testid="grg-panel" style="padding: 16px;"><div class="section" data-testid="grg-hero"><div class="section-header"><div class="section-title" style="display: inline-flex; align-items: center; gap: 6px;">Gamma Rotation Gap<span data-testid="grg-info" style="display: inline-flex; align-items: center;" aria-label="GRG methodology" tabindex="0"><span style="width: 13px; height: 13px; border-radius: 50%; border: 1px solid var(--text-muted); display: inline-flex; align-items: center; justify-content: center; font-size: 8px; color: var(--text-muted); cursor: default; line-height: 1; flex-shrink: 0;">?</span></span></div><div style="display: flex; gap: 8px; align-items: center;"><span data-testid="grg-state-badge" style="border: 1px solid var(--positive); color: var(--positive); border-radius: 999px; padding: 2px 10px; font-size: 10px; font-family: var(--font-mono); letter-spacing: 1px;">DUAL CUSHION</span><span style="font-family: var(--font-mono); font-size: 10px; color: var(--text-muted);">2026-10-02</span></div></div><div class="section-body" style="padding: 16px; display: grid; grid-template-columns: minmax(220px, 1fr) 2fr; gap: 16px; align-items: center;"><div><div style="font-size: 10px; letter-spacing: 1.5px; text-transform: uppercase; color: var(--text-muted); font-family: var(--font-mono);">GRG Residual</div><div data-testid="grg-residual" style="font-size: 56px; font-weight: 700; font-family: var(--font-mono); line-height: 1.05; color: var(--positive);">-0.33σ</div><div style="font-size: 16px; font-weight: 600; margin-top: 6px; color: var(--positive);">Dual cushion</div><div style="font-size: 12px; color: var(--text-secondary); margin-top: 6px; max-width: 380px;">Both SPY and TLT are positive gamma. Dealer hedging is dampening both equity and duration moves.</div></div><div style="display: grid; grid-template-columns: repeat(4, 1fr); gap: 10px;"><div style="padding: 10px 12px; border: 1px solid var(--border-dim); border-radius: 6px;"><div style="font-size: 10px; letter-spacing: 1.5px; text-transform: uppercase; color: var(--text-muted); font-family: var(--font-mono);">SPY GEX</div><div style="font-size: 20px; font-weight: 700; font-family: var(--font-mono); margin-top: 4px;">+113.6K</div><div style="font-size: 10px; color: var(--text-muted); font-family: var(--font-mono); margin-top: 2px;">+0.61σ</div></div><div style="padding: 10px 12px; border: 1px solid var(--border-dim); border-radius: 6px;"><div style="font-size: 10px; letter-spacing: 1.5px; text-transform: uppercase; color: var(--text-muted); font-family: var(--font-mono);">TLT GEX</div><div style="font-size: 20px; font-weight: 700; font-family: var(--font-mono); margin-top: 4px;">+6.0M</div><div style="font-size: 10px; color: var(--text-muted); font-family: var(--font-mono); margin-top: 2px;">+0.98σ</div></div><div style="padding: 10px 12px; border: 1px solid var(--border-dim); border-radius: 6px;"><div style="font-size: 10px; letter-spacing: 1.5px; text-transform: uppercase; color: var(--text-muted); font-family: var(--font-mono);">Top Gate</div><div style="font-size: 20px; font-weight: 700; font-family: var(--font-mono); margin-top: 4px;">1/5</div><div style="font-size: 10px; color: var(--text-muted); font-family: var(--font-mono); margin-top: 2px;">inactive</div></div><div style="padding: 10px 12px; border: 1px solid var(--border-dim); border-radius: 6px;"><div style="font-size: 10px; letter-spacing: 1.5px; text-transform: uppercase; color: var(--text-muted); font-family: var(--font-mono);">Bottom Gate</div><div style="font-size: 20px; font-weight: 700; font-family: var(--font-mono); margin-top: 4px;">1/5</div><div style="font-size: 10px; color: var(--text-muted); font-family: var(--font-mono); margin-top: 2px;">inactive</div></div></div></div></div><div style="display: grid; grid-template-columns: minmax(220px, 280px) 1fr; gap: 16px; margin-top: 16px;"><div style="display: flex; flex-direction: column; gap: 16px;"><div class="section" data-testid="grg-asset-SPY"><div class="section-header"><div class="section-title">SPY</div><div style="display: flex; align-items: center; gap: 6px;"><span style="border: 1px solid var(--positive); color: var(--positive); border-radius: 999px; padding: 2px 10px; font-size: 10px; font-family: var(--font-mono); letter-spacing: 1px;">CUSHION</span><span data-testid="grg-asset-state-info-SPY" style="display: inline-flex; align-items: center;" aria-label="CUSHION meaning" tabindex="0"><span style="width: 13px; height: 13px; border-radius: 50%; border: 1px solid var(--text-muted); display: inline-flex; align-items: center; justify-content: center; font-size: 8px; color: var(--text-muted); cursor: default; line-height: 1; flex-shrink: 0;">?</span></span></div></div><div class="section-body" style="padding: 12px;"><div style="font-size: 30px; font-weight: 700; font-family: var(--font-mono); color: var(--positive);">+113.6K</div><div style="display: grid; grid-template-columns: 1fr auto; gap: 6px 12px; margin-top: 12px; font-family: var(--font-mono); font-size: 12px;"><span style="color: var(--text-muted);">GAMMA Z</span><span style="text-align: right;">+0.61σ</span><span style="color: var(--text-muted);">SPOT</span><span style="text-align: right;">769.11</span><span style="color: var(--text-muted);">FLIP</span><span style="text-align: right;">770.00</span><span style="color: var(--text-muted);">SPOT VS FLIP</span><span style="text-align: right;">-0.12%</span></div></div></div><div class="section" data-testid="grg-asset-TLT"><div class="section-header"><div class="section-title">TLT</div><div style="display: flex; align-items: center; gap: 6px;"><span style="border: 1px solid var(--positive); color: var(--positive); border-radius: 999px; padding: 2px 10px; font-size: 10px; font-family: var(--font-mono); letter-spacing: 1px;">CUSHION</span><span data-testid="grg-asset-state-info-TLT" style="display: inline-flex; align-items: center;" aria-label="CUSHION meaning" tabindex="0"><span style="width: 13px; height: 13px; border-radius: 50%; border: 1px solid var(--text-muted); display: inline-flex; align-items: center; justify-content: center; font-size: 8px; color: var(--text-muted); cursor: default; line-height: 1; flex-shrink: 0;">?</span></span></div></div><div class="section-body" style="padding: 12px;"><div style="font-size: 30px; font-weight: 700; font-family: var(--font-mono); color: var(--positive);">+6.0M</div><div style="display: grid; grid-template-columns: 1fr auto; gap: 6px 12px; margin-top: 12px; font-family: var(--font-mono); font-size: 12px;"><span style="color: var(--text-muted);">GAMMA Z</span><span style="text-align: right;">+0.98σ</span><span style="color: var(--text-muted);">SPOT</span><span style="text-align: right;">77.54</span><span style="color: var(--text-muted);">FLIP</span><span style="text-align: right;">78.00</span><span style="color: var(--text-muted);">SPOT VS FLIP</span><span style="text-align: right;">-0.60%</span></div></div></div></div><div class="section" data-testid="grg-divergence-chart"><div class="section-header"><div class="section-title">YTD Divergence Field</div><div style="display: flex; gap: 12px; flex-wrap: wrap; align-items: center;"><span style="display: inline-flex; align-items: center; gap: 6px; font-family: var(--font-mono); font-size: 10px; letter-spacing: 0.06em; color: var(--text-secondary);"><svg width="12" height="12" aria-hidden="true"><circle cx="6" cy="6" r="4" fill="var(--accent-warm, #F5A623)"></circle></svg>GRG</span><span style="display: inline-flex; align-items: center; gap: 6px; font-family: var(--font-mono); font-size: 10px; letter-spacing: 0.06em; color: var(--text-secondary);"><svg width="12" height="12" aria-hidden="true"><circle cx="6" cy="6" r="4" fill="var(--accent-bg, #05AD98)"></circle></svg>SPY γ</span><span style="display: inline-flex; align-items: center; gap: 6px; font-family: var(--font-mono); font-size: 10px; letter-spacing: 0.06em; color: var(--text-secondary);"><svg width="12" height="12" aria-hidden="true"><circle cx="6" cy="6" r="4" fill="var(--negative, #FB5E7B)"></circle></svg>TLT γ</span><span style="display: inline-flex; align-items: center; gap: 6px; font-family: var(--font-mono); font-size: 10px; letter-spacing: 0.06em; color: var(--text-secondary);"><svg width="12" height="12" aria-hidden="true"><circle cx="6" cy="6" r="4" fill="rgba(226,232,240,0.8)"></circle></svg>SPY $</span><span style="display: inline-flex; align-items: center; gap: 6px; font-family: var(--font-mono); font-size: 10px; letter-spacing: 0.06em; color: var(--text-secondary);"><svg width="12" height="12" aria-hidden="true"><circle cx="6" cy="6" r="4" fill="var(--positive, #2BD9A8)"></circle></svg>TOP-WATCH</span><span style="display: inline-flex; align-items: center; gap: 6px; font-family: var(--font-mono); font-size: 10px; letter-spacing: 0.06em; color: var(--text-secondary);"><svg width="12" height="12" aria-hidden="true"><circle cx="6" cy="6" r="4" fill="var(--negative, #FB5E7B)"></circle></svg>BOTTOM-WATCH</span></div></div><div class="section-body" style="padding: 8px 12px 12px;"><svg role="img" aria-label="Year-to-date GRG divergence field with SPY price overlay" viewBox="0 0 1120 300" style="width: 100%; height: auto; display: block;"><title>GRG, SPY/TLT gamma-z, and SPY price YTD with gate-confirmed top/bottom markers</title><g><line x1="30" x2="1072" y1="264" y2="264" stroke="rgba(148,163,184,0.08)"></line><text x="30" y="261" font-size="9" font-family="var(--font-mono)" fill="var(--text-muted)">-3σ</text></g><g><line x1="30" x2="1072" y1="141" y2="141" stroke="var(--border-dim)" stroke-dasharray="2 3"></line><text x="30" y="138" font-size="9" font-family="var(--font-mono)" fill="var(--text-muted)">0σ</text></g><g><line x1="30" x2="1072" y1="18" y2="18" stroke="rgba(148,163,184,0.08)"></line><text x="30" y="15" font-size="9" font-family="var(--font-mono)" fill="var(--text-muted)">+3σ</text></g><text x="1078" y="250.0344827586214" font-size="9" font-family="var(--font-mono)" fill="var(--text-muted)" text-anchor="start">763</text><text x="1078" y="144" font-size="9" font-family="var(--font-mono)" fill="var(--text-muted)" text-anchor="start">766</text><text x="1078" y="37.96551724137862" font-size="9" font-family="var(--font-mono)" fill="var(--text-muted)" text-anchor="start">770</text><text x="30" y="280" text-anchor="middle" font-size="10" font-family="var(--font-mono)" fill="var(--text-secondary)">09/28</text><text x="290.5" y="280" text-anchor="middle" font-size="10" font-family="var(--font-mono)" fill="var(--text-secondary)">09/29</text><text x="551" y="280" text-anchor="middle" font-size="10" font-family="var(--font-mono)" fill="var(--text-secondary)">09/30</text><text x="811.5" y="280" text-anchor="middle" font-size="10" font-family="var(--font-mono)" fill="var(--text-secondary)">10/01</text><text x="1072" y="280" text-anchor="middle" font-size="10" font-family="var(--font-mono)" fill="var(--text-secondary)">10/02</text><path data-testid="grg-spy-price-line" d="M30,156.88248315214662 L290.5,199.5382950464841 L551,247.0344827586214 L811.5,205.89128830734415 L1072,34.96551724137862" fill="none" stroke="rgba(226,232,240,0.8)" stroke-width="1.4" stroke-linecap="round" opacity="0.9"></path><path d="M30,144.75560000000002 L290.5,121.8571 L551,94.29690000000002 L811.5,137.3469 L1072,100.98400000000001" fill="none" stroke="var(--negative, #FB5E7B)" stroke-width="1.2" stroke-linecap="round" opacity="0.85"></path><path d="M30,153.7961 L290.5,158.8268 L551,141.4223 L811.5,159.77800000000002 L1072,115.87110000000001" fill="none" stroke="var(--accent-bg, #05AD98)" stroke-width="1.2" stroke-linecap="round" opacity="0.85"></path><path d="M30,152.9351 L290.5,172.7627 L551,178.69129999999998 L811.5,160.58980000000003 L1072,154.6571" fill="none" stroke="var(--accent-warm, #F5A623)" stroke-width="1.8" stroke-linecap="round"></path><g data-testid="grg-event-dots"></g></svg></div></div></div><div data-testid="grg-backtest-caption" style="display: flex; align-items: baseline; gap: 6px; margin-top: 6px; font-family: var(--font-mono); font-size: 10px; letter-spacing: 0.04em; color: var(--text-muted);"><span>Backtest (YTD, 30-session window): 5 BOTTOM-WATCH led by ~27 sessions (SPY -7.5% further) · 1 TOP-WATCH led by ~13 sessions (SPY +2.3% further). Early-warning, not the turn.</span><span data-testid="grg-backtest-info" style="display: inline-flex; align-items: center;" aria-label="GRG top/bottom backtest" tabindex="0"><span style="width: 13px; height: 13px; border-radius: 50%; border: 1px solid var(--text-muted); display: inline-flex; align-items: center; justify-content: center; font-size: 8px; color: var(--text-muted); cursor: default; line-height: 1; flex-shrink: 0;">?</span></span></div><div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-top: 16px;"><div class="section" data-testid="grg-top"><div class="section-header"><div class="section-title">Top Identification</div></div><div class="section-body" style="padding: 12px; font-size: 12px; color: var(--text-secondary);">Potential top: stretched positive GRG, positive SPY gamma, equity cushion decay, and duration gamma stress.<div style="margin-top: 8px; font-family: var(--font-mono); font-size: 11px; color: var(--text-muted);">NO CONFIRMED TOP WATCH</div></div></div><div class="section" data-testid="grg-bottom"><div class="section-header"><div class="section-title">Bottom Identification</div></div><div class="section-body" style="padding: 12px; font-size: 12px; color: var(--text-secondary);">Potential bottom: stretched negative GRG, SPY gamma repair, and recapture of the SPY gamma flip after stress.<div style="margin-top: 8px; font-family: var(--font-mono); font-size: 11px; color: var(--text-muted);">NO CONFIRMED BOTTOM WATCH</div></div></div></div><div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-top: 16px;"><div class="section" data-testid="grg-recent-tops"><div class="section-header"><div class="section-title">Recent Top-Watches</div></div><div class="section-body" style="padding: 12px;"><div data-testid="grg-event-row" style="padding: 8px 0px; border-bottom: 1px solid var(--border-dim);"><div style="display: grid; grid-template-columns: auto 64px 1fr auto; gap: 8px; align-items: baseline; font-family: var(--font-mono); font-size: 12px;"><span style="color: var(--text-secondary);">2026-05-13</span><span style="color: var(--positive); text-align: right; font-weight: 700;">+2.06σ</span><span style="color: var(--positive); letter-spacing: 0.5px;">RISK-ON</span><span style="color: var(--text-muted);">T3</span></div><div style="font-family: var(--font-mono); font-size: 10px; color: var(--text-muted); margin-top: 2px;">SPY +437.9K · TLT -9.9M<span style="color: var(--text-secondary);"> · led 13d, SPY +2.3% to extreme</span></div></div></div></div><div class="section" data-testid="grg-recent-bottoms"><div class="section-header"><div class="section-title">Recent Bottom-Watches</div></div><div class="section-body" style="padding: 12px;"><div data-testid="grg-event-row" style="padding: 8px 0px; border-bottom: 1px solid var(--border-dim);"><div style="display: grid; grid-template-columns: auto 64px 1fr auto; gap: 8px; align-items: baseline; font-family: var(--font-mono); font-size: 12px;"><span style="color: var(--text-secondary);">2026-06-26</span><span style="color: var(--negative); text-align: right; font-weight: 700;">-2.58σ</span><span style="color: var(--negative); letter-spacing: 0.5px;">RISK-OFF</span><span style="color: var(--text-muted);">T1</span></div><div style="font-family: var(--font-mono); font-size: 10px; color: var(--text-muted); margin-top: 2px;">SPY -2.7M · TLT +22.1M<span style="color: var(--text-secondary);"> · led 22d, SPY +0.1% to extreme</span></div></div><div data-testid="grg-event-row" style="padding: 8px 0px; border-bottom: 1px solid var(--border-dim);"><div style="display: grid; grid-template-columns: auto 64px 1fr auto; gap: 8px; align-items: baseline; font-family: var(--font-mono); font-size: 12px;"><span style="color: var(--text-secondary);">2026-02-20</span><span style="color: var(--negative); text-align: right; font-weight: 700;">-2.59σ</span><span style="color: var(--negative); letter-spacing: 0.5px;">RISK-OFF</span><span style="color: var(--text-muted);">T2</span></div><div style="font-family: var(--font-mono); font-size: 10px; color: var(--text-muted); margin-top: 2px;">SPY -2.5M · TLT +24.0M<span style="color: var(--text-secondary);"> · led 26d, SPY -8.3% to extreme</span></div></div></div></div></div><div style="margin-top: 6px; font-size: 10px; font-family: var(--font-mono); color: var(--text-muted);">Gate-confirmed TOP_WATCH / BOTTOM_WATCH days, YTD. Spot-vs-flip excluded — UW history carries no per-day gamma flip.</div><div style="margin-top: 16px;"><div class="section" data-testid="grg-gates"><div class="section-header"><div class="section-title">Signal Gates</div></div><div class="section-body" style="padding: 12px; display: flex; flex-direction: column; gap: 8px;"><div data-testid="grg-gate-polarity" style="display: grid; grid-template-columns: 120px 1fr auto; gap: 12px; align-items: center;"><span style="font-family: var(--font-mono); font-size: 11px; letter-spacing: 1px; text-transform: uppercase; color: var(--text-muted);">Polarity</span><span style="font-size: 12px; color: var(--text-secondary);">SPY positive and TLT negative identifies the clean risk-on divergence.</span><span style="font-family: var(--font-mono); font-size: 12px; font-weight: 700; color: var(--warning);">WATCH</span></div><div data-testid="grg-gate-magnitude" style="display: grid; grid-template-columns: 120px 1fr auto; gap: 12px; align-items: center;"><span style="font-family: var(--font-mono); font-size: 11px; letter-spacing: 1px; text-transform: uppercase; color: var(--text-muted);">Magnitude</span><span style="font-size: 12px; color: var(--text-secondary);">Absolute GRG above 2σ means the cross-asset gamma spread is statistically stretched.</span><span style="font-family: var(--font-mono); font-size: 12px; font-weight: 700; color: var(--warning);">WATCH</span></div><div data-testid="grg-gate-spy_cushion" style="display: grid; grid-template-columns: 120px 1fr auto; gap: 12px; align-items: center;"><span style="font-family: var(--font-mono); font-size: 11px; letter-spacing: 1px; text-transform: uppercase; color: var(--text-muted);">SPY cushion</span><span style="font-size: 12px; color: var(--text-secondary);">Positive SPY gamma means dealer hedging is mechanically dampening equity moves.</span><span style="font-family: var(--font-mono); font-size: 12px; font-weight: 700; color: var(--positive);">PASS</span></div><div data-testid="grg-gate-duration_whip" style="display: grid; grid-template-columns: 120px 1fr auto; gap: 12px; align-items: center;"><span style="font-family: var(--font-mono); font-size: 11px; letter-spacing: 1px; text-transform: uppercase; color: var(--text-muted);">TLT whip</span><span style="font-size: 12px; color: var(--text-secondary);">Negative TLT gamma means duration moves are mechanically amplified.</span><span style="font-family: var(--font-mono); font-size: 12px; font-weight: 700; color: var(--warning);">WATCH</span></div><div data-testid="grg-gate-decay" style="display: grid; grid-template-columns: 120px 1fr auto; gap: 12px; align-items: center;"><span style="font-family: var(--font-mono); font-size: 11px; letter-spacing: 1px; text-transform: uppercase; color: var(--text-muted);">Decay</span><span style="font-size: 12px; color: var(--text-secondary);">A negative 3-session SPY gamma slope marks possible equity cushion decay.</span><span style="font-family: var(--font-mono); font-size: 12px; font-weight: 700; color: var(--warning);">WATCH</span></div><div data-testid="grg-gate-flip" style="display: grid; grid-template-columns: 120px 1fr auto; gap: 12px; align-items: center;"><span style="font-family: var(--font-mono); font-size: 11px; letter-spacing: 1px; text-transform: uppercase; color: var(--text-muted);">Flip</span><span style="font-size: 12px; color: var(--text-secondary);">Spot above the SPY gamma flip keeps the equity cushion valid.</span><span style="font-family: var(--font-mono); font-size: 12px; font-weight: 700; color: var(--warning);">WATCH</span></div></div></div></div></div>"`;

exports[`MacdLegend markup snapshot > bearish 1`] = `"<div style="margin-top: 4px; display: flex; gap: 16px; align-items: center;"><span style="display: inline-flex; align-items: center; gap: 5px;"><span style="width: 14px; height: 9px; background: var(--accent-vol); opacity: 0.5; display: inline-block; border-radius: 1px;"></span><span style="font-size: 10px; color: var(--text-muted);">SLOW 55/89/34 · structural</span></span><span style="display: inline-flex; align-items: center; gap: 5px;"><span style="display: inline-flex; width: 8px; height: 9px;" aria-hidden="true"><span style="flex: 1 1 0%; background: var(--positive);"></span><span style="flex: 1 1 0%; background: var(--negative);"></span></span><span style="font-size: 10px; color: var(--text-muted);">FAST 13/21/9 · tactical</span></span><span data-testid="technicals-macd-signal" style="margin-left: auto; font-family: var(--font-mono); font-size: 11px; letter-spacing: 1px; font-weight: 700; color: var(--negative);">BEARISH</span></div>"`;

exports[`MacdLegend markup snapshot > none 1`] = `"<div style="margin-top: 4px; display: flex; gap: 16px; align-items: center;"><span style="display: inline-flex; align-items: center; gap: 5px;"><span style="width: 14px; height: 9px; background: var(--accent-vol); opacity: 0.5; display: inline-block; border-radius: 1px;"></span><span style="font-size: 10px; color: var(--text-muted);">SLOW 55/89/34 · structural</span></span><span style="display: inline-flex; align-items: center; gap: 5px;"><span style="display: inline-flex; width: 8px; height: 9px;" aria-hidden="true"><span style="flex: 1 1 0%; background: var(--positive);"></span><span style="flex: 1 1 0%; background: var(--negative);"></span></span><span style="font-size: 10px; color: var(--text-muted);">FAST 13/21/9 · tactical</span></span></div>"`;
